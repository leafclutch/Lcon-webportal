{
  "$schema": "node_modules/wrangler/config-schema.json",

  // Worker name
  "name": "lcon-webportal",

  // OpenNext generated worker entry
  "main": ".open-next/worker.js",

  // Compatibility
  "compatibility_date": "2026-04-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],

  // Keep workers.dev URL enabled
  "workers_dev": true,

  // Enable preview URLs
  "preview_urls": true,

  // Production custom domain
  "routes": [
    {
      "pattern": "lcon.leafclutch.com.np",
      "custom_domain": true
    }
  ],

  // Static assets generated by OpenNext
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Self-reference binding for caching / internal fetch
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lcon-webportal"
    }
  ],

  // Cloudflare Images binding
  "images": {
    "binding": "IMAGES"
  },

  // Logging / observability
  "observability": {
    "logs": {
      "enabled": true
    }
  }
}